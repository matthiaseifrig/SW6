rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Teammitglied = angemeldet UND hat ein users/{uid}-Dokument (entsteht
    // automatisch beim ersten Login). Zugaenge legt nur der Chef in der
    // Firebase-Konsole an, eine Selbstregistrierung gibt es nicht.
    function isMember() {
      return isSignedIn() && exists(myUserPath());
    }

    function isOwnerRole() {
      return isMember() && get(myUserPath()).data.role == 'owner';
    }

    // Einzelnen Kolleg:innen kann "owner" zusaetzlich Lesezugriff auf die
    // Finanzkennzahlen ihrer eigenen Kunden geben (Feld financialsAccess auf
    // dem eigenen users/{uid}-Dokument, manuell in der Firebase-Konsole
    // gesetzt - genau wie die Rolle "owner" selbst).
    function hasFinancialsAccess() {
      return isMember() && get(myUserPath()).data.financialsAccess == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Eine Firma "gehoert" zu einer Person, wenn sie Besitzer ist (ownerUid)
    // oder in deren Adresspool aufgenommen ist (poolUids).
    function inPool(data) {
      return data.ownerUid == request.auth.uid ||
        request.auth.uid in data.get('poolUids', []);
    }

    function firmInPool(customerId) {
      return inPool(get(/databases/$(database)/documents/customers/$(customerId)).data);
    }

    // Benutzer: Alle im Team duerfen die Benutzerliste lesen (Namen und
    // Funktionen, z. B. fuer "Termin fuer wen?"). Beim ersten Login legt
    // jede/r das eigene Profil an - nur mit Name, E-Mail, Rolle "colleague"
    // und Zeitstempel. Rolle, Funktionen (presales/werber/makler) und
    // financialsAccess setzt ausschliesslich "owner".
    match /users/{uid} {
      allow read: if isMember() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'colleague'
                    && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      allow update: if isOwnerRole();
    }

    // Firmen: Jede/r sieht und bearbeitet NUR die eigenen bzw. zugeordneten
    // Firmen (ownerUid / poolUids). "owner" (Admin) sieht alle. Wem eine
    // Firma gehoert (ownerUid, createdBy, createdAt, source), aendert nur
    // "owner"; loeschen bzw. zusammenfuehren ebenfalls nur "owner".
    match /customers/{customerId} {
      allow read: if isOwnerRole() || (isMember() && inPool(resource.data));
      allow create: if isOwnerRole() ||
        (isMember() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isOwnerRole() ||
        (isMember() && inPool(resource.data) &&
          !changedKeys().hasAny(['ownerUid', 'createdBy', 'createdAt', 'source']));
      allow delete: if isOwnerRole();

      match /visits/{visitId} {
        allow read: if isOwnerRole() || (isMember() && firmInPool(customerId));
        allow create: if isOwnerRole() ||
          (isMember() && firmInPool(customerId) && request.resource.data.byUid == request.auth.uid);
        // Nachtraegliches Ergaenzen (Mitgliedsaufnahme, ToDo erledigt ...)
        // durch die Person, die den Besuch eingetragen hat (oder "owner").
        allow update: if isOwnerRole() ||
          (isMember() && resource.data.byUid == request.auth.uid);
        allow delete: if isOwnerRole();
      }

      // Finanzkennzahlen (Umsatz, Gewinn, CAGR, Mitarbeiterzahl,
      // Pensionsrückstellungen, ...) sind vertraulich - grundsaetzlich nur
      // "owner". Einzelne Kolleg:innen mit financialsAccess=true duerfen sie
      // zusaetzlich lesen, aber nur fuer ihre eigenen Kunden. Schreiben
      // bleibt in jedem Fall "owner" vorbehalten.
      match /financials/{docId} {
        allow read: if isOwnerRole() ||
          (hasFinancialsAccess() &&
            get(/databases/$(database)/documents/customers/$(customerId)).data.ownerUid == request.auth.uid);
        allow write: if isOwnerRole();
      }
    }

    // Dubletten-Schluessel: nur Einzelabfrage per Schluessel erlaubt ("gibt
    // es diese Firma schon?"), kein Auflisten - so erfahren Kolleg:innen
    // nicht, welche Firmen andere betreuen. Neue Schluessel darf anlegen,
    // wer gerade eine eigene Firma anlegt; aendern/loeschen nur "owner".
    match /firmKeys/{key} {
      allow get: if isMember();
      allow list: if isOwnerRole();
      allow create: if isOwnerRole() ||
        (isMember() && firmInPool(request.resource.data.customerId));
      allow update, delete: if isOwnerRole();
    }

    // Anrufe: sehen darf man eigene Anrufe und Anrufe zu Firmen im eigenen
    // Pool (z. B. sieht der Werber die Anrufe von Pre-Sales bei seiner
    // Firma). Eintragen nur im eigenen Namen bei Firmen im eigenen Pool.
    match /calls/{callId} {
      allow read: if isOwnerRole() ||
        (isMember() && (resource.data.byUid == request.auth.uid || firmInPool(resource.data.customerId)));
      allow create: if isOwnerRole() ||
        (isMember() && request.resource.data.byUid == request.auth.uid &&
          firmInPool(request.resource.data.customerId));
      allow update: if isMember() &&
        (resource.data.byUid == request.auth.uid || isOwnerRole()) &&
        request.resource.data.byUid == resource.data.byUid;
      allow delete: if isOwnerRole();
    }

    // Termine: sehen darf man Termine, die man vereinbart hat oder
    // wahrnimmt, und Termine zu Firmen im eigenen Pool. "Durchgefuehrt" und
    // das Ergebnis (Mitglied / Abschluss) setzt nur, wer den Termin
    // wahrnimmt - oder "owner". Wer den Termin vereinbart hat, bleibt fest.
    match /appointments/{apptId} {
      allow read: if isOwnerRole() ||
        (isMember() && (resource.data.setByUid == request.auth.uid ||
          resource.data.forUid == request.auth.uid ||
          firmInPool(resource.data.customerId)));
      allow create: if isOwnerRole() ||
        (isMember() && request.resource.data.setByUid == request.auth.uid &&
          firmInPool(request.resource.data.customerId));
      allow update: if isMember() &&
        (isOwnerRole() ||
          (request.resource.data.setByUid == resource.data.setByUid &&
            (request.auth.uid == resource.data.forUid ||
              (request.auth.uid == resource.data.setByUid &&
                request.resource.data.status != 'durchgefuehrt' &&
                !changedKeys().hasAny(['outcome', 'doneAt', 'doneByUid'])))));
      allow delete: if isOwnerRole();
    }
  }
}
